{
  "name": "@local/dsh-forge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "锻造模式 —— DSH agent 预设。选这个模式，forge 的能力才存在；不选，插件图里一行都没有。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "mods": "node scripts/mods-check.mjs",
    "prompt": "node scripts/prompt-diff.mjs"
  }
}
